# Copy to a local .env only after selecting the actual bucket/account.
# The CLI does NOT load .env; set values in the shell or as CI secrets.
# The config file stores only these variable NAMES, never their values.
# The S3 API URL; the dashboard's bucket-scoped form (.../your-asset-bucket) also works.
# Not the public pub-....r2.dev URL: that is a public-http read base in the config.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=your-asset-bucket
# Author uploads (push): bucket-scoped read/write token. Never give these to CI builds.
R2_WRITE_ACCESS_KEY_ID=
R2_WRITE_SECRET_ACCESS_KEY=
# Build retrieval when r2.read.transport is "s3-readonly": a separate token scoped to reading
# this bucket's objects, never the writer token under these names. The only pair CI gets.
R2_READ_ACCESS_KEY_ID=
R2_READ_SECRET_ACCESS_KEY=
